# Copy to `.env` for local development. The server reads its settings once, at
# startup. Each setting's variable is `APP_` followed by its path in upper case,
# with `__` between nested keys. An empty variable counts as unset.

# `development` or `production` (default).
APP_ENV=development

# Address the HTTP server listens on. Default: 127.0.0.1:8080.
APP_SERVER__BIND_ADDRESS=127.0.0.1:8080

# Where browsers reach the portal: scheme, host and port. Required. Session
# cookies need HTTPS, except on localhost.
APP_SERVER__ORIGIN=http://localhost:8080

# `text` (default) or `json`.
APP_LOG_FORMAT=text

# Postgres database of the portal. Required. Migrations run at startup.
# Connections are not encrypted yet; keep the database on a private network.
APP_DATABASE__URL=postgres://postgres:postgres@localhost:5432/portal

# Most connections the pool keeps open. Default: 10.
APP_DATABASE__POOL_SIZE=10

# Secret that encrypts session cookies: 64 random bytes in hex. Required.
# Generate one with `openssl rand -hex 64`. Changing it signs everyone out.
APP_SESSION__KEY=

# GitHub OAuth app that signs developers in. Required. Its callback URL must be
# APP_SERVER__ORIGIN followed by /api/v1/session/github/callback.
APP_GITHUB__CLIENT_ID=
APP_GITHUB__CLIENT_SECRET=

# The Status List Server's admin API, where the portal registers issuers.
# Required, except ALGORITHM. The server's registry file lists the portal under
# `admins` with the `issuers:read` and `issuers:write` scopes: PRINCIPAL is that
# entry's `id`, KEY_ID and ALGORITHM its key's `kid` and `alg`. AUDIENCE is one
# of the server's `admin_auth.audiences`.
APP_ADMIN_API__URL=http://localhost:8002
APP_ADMIN_API__PRINCIPAL=portal
APP_ADMIN_API__AUDIENCE=
APP_ADMIN_API__KEY_ID=
# `ES256` (default), `ES384`, `EdDSA` or `PS256`.
APP_ADMIN_API__ALGORITHM=ES256
# The key's private half, as a PKCS#8 PEM file. For ES256, make one with
# `openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out admin-key.pem`.
APP_ADMIN_API__SIGNING_KEY_FILE=admin-key.pem

# Server where tests create a database of their own; the database named here is
# only a prefix for their names. Needed by `cargo test`, not by the server.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/portal_test

# Log filter, in tracing `EnvFilter` syntax. Default: info.
RUST_LOG=info
