# Copy to `.env` for local development, and keep it to yourself: `chmod 600 .env`.
# The server reads its settings once, at startup. Each setting's variable is
# `APP_` followed by its path in upper case, with `__` between nested keys. An
# empty variable counts as unset.
#
# The secrets, APP_DATABASE__URL, APP_SESSION__KEY, APP_GITHUB__CLIENT_SECRET
# and APP_EMAIL__SMTP_URL, can come from files instead, as Docker and Kubernetes
# mount them: set APP_SESSION__KEY_FILE=/run/secrets/session-key, for example,
# and leave APP_SESSION__KEY unset. The file's final line break is ignored.

# `development` or `production` (default).
APP_ENV=development

# Address the HTTP server listens on. Default: 127.0.0.1:8080.
APP_SERVER__BIND_ADDRESS=127.0.0.1:8080

# The built frontend, which the server then serves: run `bun run build` first.
# Leave it empty while `bun run dev` serves the frontend.
APP_SERVER__FRONTEND_DIR=

# Where browsers reach the portal: scheme, host and port. Required. Session
# cookies need HTTPS, except on localhost.
APP_SERVER__ORIGIN=http://localhost:8080

# The proxies in front of the server, such as a Kubernetes ingress: addresses or
# CIDR blocks, separated by commas. The server reads the client's address from
# X-Forwarded-For only when a listed proxy sends the request. Behind a proxy
# that is not listed, every client shares the proxy's sign-in limit. Default:
# none, for a server that clients reach directly.
APP_SERVER__TRUSTED_PROXIES=

# `text` (default) or `json`.
APP_LOG_FORMAT=text

# Telemetry. Server log lines go to stdout; command log lines go to stderr.
# Set an OTLP endpoint to also send traces, metrics and logs there, over HTTP;
# docs/telemetry.md lists the other OTEL_* variables. For
# `docker compose --profile observability up -d`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Portal Postgres connection string. Required. The migration job and server use
# separate role credentials here; see docs/deployment.md for roles and TLS.
APP_DATABASE__URL=postgres://postgres:postgres@localhost:5432/portal

# Optional PEM trust bundle replacing system CAs; see docs/deployment.md.
# APP_DATABASE__TLS_CA_FILE=/run/secrets/postgres-ca.pem

# Most connections the pool keeps open. Default: 10.
APP_DATABASE__POOL_SIZE=10

# Secret that encrypts session cookies: 64 random bytes in hex. Required.
# Generate one with `openssl rand -hex 64`. Changing it signs everyone out.
APP_SESSION__KEY=

# GitHub OAuth app that signs developers in. Required. Its callback URL must be
# APP_SERVER__ORIGIN followed by /api/v1/session/github/callback.
APP_GITHUB__CLIENT_ID=
APP_GITHUB__CLIENT_SECRET=

# The Status List Server's admin API, where the portal registers issuers.
# Required, except ALGORITHM. The server's registry file lists the portal under
# `admins` with the `issuers:read` and `issuers:write` scopes: PRINCIPAL is that
# entry's `id`, KEY_ID and ALGORITHM its key's `kid` and `alg`. AUDIENCE is one
# of the server's `admin_auth.audiences`.
APP_ADMIN_API__URL=http://localhost:8002
APP_ADMIN_API__PRINCIPAL=portal
APP_ADMIN_API__AUDIENCE=
APP_ADMIN_API__KEY_ID=
# `ES256` (default), `ES384`, `EdDSA` or `PS256`.
APP_ADMIN_API__ALGORITHM=ES256
# The key's private half, as a PKCS#8 PEM file. For ES256, make one with
# `openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out admin-key.pem`.
APP_ADMIN_API__SIGNING_KEY_FILE=admin-key.pem

# The server's management API, where developers' issuers send their tokens. The
# portal shows both next to every issuer. Required. AUDIENCE is one of the
# server's `management_auth.audiences`.
APP_MANAGEMENT_API__URL=http://localhost:8000
APP_MANAGEMENT_API__AUDIENCE=http://localhost:8000

# Limits on sandbox issuers; 0 stops new registrations. An account may have 2
# active issuers and register 10 in all, deleted ones included. The sandbox
# holds 100 active issuers.
APP_SANDBOX__MAX_ISSUERS_PER_ACCOUNT=2
APP_SANDBOX__MAX_REGISTRATIONS_PER_ACCOUNT=10
APP_SANDBOX__MAX_ACTIVE_ISSUERS=100
# Days a new or renewed issuer stays active, at most the server's limit for
# the sandbox tier. Default: 30.
APP_SANDBOX__LIFETIME_DAYS=30
# `true` to have an operator approve every registration with
# `portal approve-registration`. Default: false.
APP_SANDBOX__MANUAL_APPROVAL=false

# Terms of use developers accept before they register or renew an issuer.
# Required. Change the version whenever the document at the URL changes: it is
# what the portal records as accepted. Everyone must then accept again before
# registering or renewing, and issuers of those who do not will expire.
APP_TERMS__VERSION=2026-10-22
APP_TERMS__URL=http://localhost:8080/terms

# Email, which only `portal send-reminders` sends, to warn developers before
# their sandbox issuers expire. The server does not read these. Any SMTP server
# works, such as smtp://user:password@smtp.eu.mailgun.org:587?tls=required;
# production refuses plain smtp:// unless the server is on loopback. SMTP_URL
# holds the password, so it can come from a file too. REPLY_TO is optional.
# `docker compose up -d mailpit` catches the emails at http://localhost:8025.
APP_EMAIL__SMTP_URL=smtp://localhost:1025
APP_EMAIL__FROM=Status List Portal <noreply@localhost>
APP_EMAIL__REPLY_TO=

# Rate limits: how many times in a row (BURST), then once every how many
# seconds (REFILL_SECONDS). Registering, renewing and deleting are counted per
# developer, across all replicas; finishing a sign-in is counted per client
# network, by each replica. Too many changes get `429 Too Many Requests`; too
# many sign-ins go to the home page with an error. Each number can be set
# alone. Defaults:
# APP_RATE_LIMITS__REGISTER__BURST=5
# APP_RATE_LIMITS__REGISTER__REFILL_SECONDS=600
# APP_RATE_LIMITS__RENEW__BURST=10
# APP_RATE_LIMITS__RENEW__REFILL_SECONDS=60
# APP_RATE_LIMITS__DELETE__BURST=20
# APP_RATE_LIMITS__DELETE__REFILL_SECONDS=30
# APP_RATE_LIMITS__SIGN_IN__BURST=20
# APP_RATE_LIMITS__SIGN_IN__REFILL_SECONDS=6

# Server where tests create a database of their own; the database named here is
# only a prefix for their names. Needed by `cargo test`, not by the server.
# Its role needs CREATEDB, CREATEROLE and authority to set default privileges
# for the roles it creates (the local postgres superuser works). Tests clean
# up the distinct DDL and DML roles with their test databases.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/portal_test

# Mailpit, where tests send email: its SMTP server and its API. Needed by
# `cargo test`; `docker compose up -d mailpit` starts it.
TEST_SMTP_URL=smtp://localhost:1025
TEST_MAILPIT_URL=http://localhost:8025

# Log filter, in tracing `EnvFilter` syntax. Default: info.
RUST_LOG=info
