# Copy to `.env` for local development. The server reads its settings once, at
# startup. Each setting's variable is `APP_` followed by its path in upper case,
# with `__` between nested keys. An empty variable counts as unset.

# `development` (default) or `production`.
APP_ENV=development

# Address the HTTP server listens on. Default: 127.0.0.1:8080.
APP_SERVER__BIND_ADDRESS=127.0.0.1:8080

# `text` (default) or `json`.
APP_LOG_FORMAT=text

# Log filter, in tracing `EnvFilter` syntax. Default: info.
RUST_LOG=info
