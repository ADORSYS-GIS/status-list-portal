---
source: src/openapi.rs
expression: openapi
---
{
  "openapi": "3.1.0",
  "info": {
    "title": "Status List Portal API",
    "description": "API between the portal's frontend and its backend. It is not a public contract and can change in any release.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.0.0"
  },
  "paths": {
    "/api/v1/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "The signed-in user.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The signed-in user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "delete": {
        "tags": [
          "session"
        ],
        "summary": "Signs out of every browser at once.",
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Signed out, or was not signed in."
          }
        }
      }
    },
    "/api/v1/session/github": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Starts signing in: sends the browser to GitHub to approve the portal.",
        "operationId": "begin",
        "responses": {
          "303": {
            "description": "Redirects to GitHub.",
            "headers": {
              "location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session/github/callback": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Finishes signing in when GitHub sends the browser back, then goes to the home page.",
        "description": "The browser is navigating, not fetching, so failures also go to the home page, which\nexplains them.",
        "operationId": "callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "description": "Code to trade for a token, when the user approved the portal.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "The `state` the sign-in started with.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "description": "Why GitHub did not approve, for example `access_denied`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirects to the home page. After a failure, its `sign_in_error` parameter says why: `denied`, `expired`, `no_verified_email` or `unavailable`.",
            "headers": {
              "location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe: the process is up and answers requests.",
        "operationId": "live",
        "responses": {
          "200": {
            "description": "The server is running.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness probe: the server can reach its database.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "The server can handle requests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The database cannot be reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorDetail": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Human-readable description, safe to show to the user."
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetail"
            },
            "description": "What prevented the request from succeeding. Always exactly one entry."
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "login",
          "name",
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "Verified primary email on GitHub.",
            "example": "octocat@example.com"
          },
          "login": {
            "type": "string",
            "description": "GitHub login.",
            "example": "octocat"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name from the GitHub profile.",
            "example": "The Octocat"
          }
        }
      }
    }
  }
}
